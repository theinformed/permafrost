Bootstrap: docker
From: python@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3

# permafrost.def -- One pinned Python for every model round, home and cluster alike.
# Created by Sean Egan 2026-10-14
# Only the environment lives here. The round bundle carries the audit code,
# so a code fix never needs a new image. Build it with build.sh on proc1.
# The base digest is python:3.11.15-slim-bookworm as pulled on 2026-10-14.

%arguments
    VERSION=dev

%files
    hpc/rounds/1/compute-requirements.txt /opt/permafrost/compute-requirements.txt

%post
    set -eu
    export PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore
    cd /opt/permafrost
    # The round's pins, line for line. A test keeps this list and the file in step.
    cat > pins.txt <<'PINS'
torch==2.8.0
transformers==4.56.2
huggingface_hub==0.35.3
safetensors==0.6.2
accelerate==1.10.1
requests==2.32.5
jinja2==3.1.6
sentencepiece==0.2.1
pillow==11.3.0
mistral-common==1.8.5
pydantic==2.14.1
pydantic-core==2.50.1
pydantic-extra-types==2.11.1
pycountry==26.2.16
annotated-types==0.8.0
typing-inspection==0.4.4
jsonschema==4.26.0
jsonschema-specifications==2025.9.1
referencing==0.37.0
rpds-py==2026.9.1
attrs==26.1.0
tiktoken==0.14.0
protobuf==6.32.1
PINS
    # What the pins pull in, held at the versions the home venv proved.
    cat > held.txt <<'HELD'
certifi==2026.7.22
charset-normalizer==3.5.2
filelock==3.32.3
fsspec==2026.7.0
hf-xet==1.7.0
idna==3.20
MarkupSafe==3.0.3
mpmath==1.3.0
networkx==3.6.1
numpy==2.4.6
packaging==26.3
psutil==7.2.2
PyYAML==6.0.3
regex==2026.9.29
sympy==1.14.0
tokenizers==0.22.2
tqdm==4.70.1
typing_extensions==4.16.0
urllib3==2.8.0
HELD
    # Stop the build if the copied requirements and the list above disagree.
    grep -v '^#' compute-requirements.txt | sed '/^$/d' > wanted.txt
    cmp -s wanted.txt pins.txt || { echo 'pins differ from compute-requirements.txt'; diff wanted.txt pins.txt; exit 1; }
    rm wanted.txt
    # Wheels only: nothing compiles, and torch comes as the CUDA 12.8 build.
    python3 -m pip install --only-binary=:all: -r pins.txt -c held.txt
    python3 -m pip check
    python3 -m pip freeze --all > freeze.txt
    python3 -c "import torch; assert torch.version.cuda == '12.8', torch.version.cuda"
    find /usr/local/lib/python3.11 -name __pycache__ -prune -exec rm -rf {} +
    {
        echo "image: permafrost"
        echo "version: {{ VERSION }}"
        echo "built: $(date -u +%FT%TZ)"
        echo "python: $(python3 --version 2>&1 | cut -d' ' -f2)"
        echo "requirements sha256: $(sha256sum compute-requirements.txt | cut -d' ' -f1)"
        echo "freeze sha256: $(sha256sum freeze.txt | cut -d' ' -f1)"
    } > /etc/permafrost-image.txt
    cat /etc/permafrost-image.txt

%environment
    export LC_ALL=C.UTF-8 PYTHONNOUSERSITE=1 PIP_NO_INDEX=1 PYTHONDONTWRITEBYTECODE=1
    export PERMAFROST_IMAGE=/etc/permafrost-image.txt

%labels
    Name permafrost
    Version {{ VERSION }}

%test
    python3 -c "import torch, transformers, mistral_common, safetensors; print(torch.__version__, torch.version.cuda, transformers.__version__)"
