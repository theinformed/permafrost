#!/usr/bin/env python3
# qsub -- Queue tiny local PBS jobs in the same table as the fake sbatch.
# Created by Sean Egan 2026-10-29
# The fake sbatch runs both kinds: sbatch --run-pending starts queued PBS jobs as well.
import importlib.machinery
import importlib.util
import os
import re
from pathlib import Path
import sys

loader = importlib.machinery.SourceFileLoader('fake_sbatch', str(Path(__file__).resolve().with_name('sbatch')))
spec = importlib.util.spec_from_loader('fake_sbatch', loader)
fake = importlib.util.module_from_spec(spec)
loader.exec_module(fake)

VALUED = ('-q', '-A', '-l', '-N', '-S', '-j', '-o', '-e', '-v', '-W')


def main():
    arguments = sys.argv[1:]
    index = 0
    while index < len(arguments) - 1:
        if arguments[index] not in VALUED:
            raise SystemExit('qsub: unknown option ' + arguments[index])
        index += 2
    if index != len(arguments) - 1 or not Path(arguments[-1]).is_file():
        raise SystemExit('qsub: the last argument must be the job script')
    # Wheat hands out whole nodes: every select line names ncpus=92 and mpiprocs, and no memory.
    selects = [arguments[position + 1] for position, argument in enumerate(arguments[:-1])
               if argument == '-l' and arguments[position + 1].startswith('select=')]
    if len(selects) != 1 or not re.fullmatch(
            r'select=[1-9][0-9]*:ncpus=92:mpiprocs=[1-9][0-9]*(:(ngpus=1|nmlas=[46]|bigmem=1))*', selects[0]):
        raise SystemExit('qsub: Error: Please include number of nodes with -l select:\n'
                         'Standard computes:    select=<number of nodes>:ncpus=92:mpiprocs=<MPI processes per node>')
    rows = fake.load()
    job = '{}.fake-pbs'.format(1000 + len(rows) + 1)
    home = os.environ['HOME']
    # A PBS job starts in home; the job script moves to its pinned copy itself.
    record = {'job': job, 'scheduler': 'pbs', 'arguments': arguments, 'status': 'queued', 'cwd': home}
    record['environment'] = {key: os.environ[key] for key in fake.KEYS if key in os.environ}
    for position, argument in enumerate(arguments[:-1]):
        if argument == '-v':
            for field in arguments[position + 1].split(','):
                key, value = field.split('=', 1)
                record['environment'][key] = value
    fake.queue(record)
    print(job)


if __name__ == '__main__':
    main()
