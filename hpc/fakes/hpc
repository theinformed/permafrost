#!/usr/bin/env python3
# hpc -- Copy rehearsal drops into a local outbox.
# Created by LT Sean Egan, PhD 2026-10-13
# Modified: SDE 2026-10-13  make result delivery visible without a network.
import os
from pathlib import Path
import shutil
import sys
if len(sys.argv) < 3 or sys.argv[1] != 'send':
    raise SystemExit('the rehearsal supports hpc send only')
source = Path(sys.argv[2])
name = sys.argv[3] if len(sys.argv) == 4 else source.name
if Path(name).name != name:
    raise SystemExit('drop name must be a plain filename')
outbox = Path(os.environ['AUDIT_FAKE_ROOT']) / 'outbox'
outbox.mkdir(exist_ok=True)
shutil.copyfile(str(source), str(outbox / name))
print('hpc send: ' + name + ' is on the desk (local rehearsal)')
